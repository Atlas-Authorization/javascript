{
  "name": "@atlasauth/capacitor",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@atlasauth/js": ">=0.39.0 <1.0.0",
    "@capacitor/core": ">=6",
    "@capacitor/browser": ">=6",
    "@capacitor/app": ">=6",
    "@capacitor/preferences": ">=6"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/browser": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlasauth/js": "workspace:*",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.5",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
