{
  "name": "@atlasauth/tanstack-react-start",
  "version": "0.3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/react": "workspace:^"
  },
  "devDependencies": {
    "@atlasauth/backend": "workspace:*",
    "@types/node": "^22.9.0",
    "jose": "^5.9.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@atlasauth/backend": ">=0.51.0 <1.0.0"
  }
}
