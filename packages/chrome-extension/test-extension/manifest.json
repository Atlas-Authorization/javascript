{
  "manifest_version": 3,
  "name": "Atlas test extension",
  "version": "1.0.0",
  "description": "Signs in with Atlas; used to check the SDK bundle against addons.mozilla.org rules.",
  "permissions": ["identity", "tabs", "storage"],
  "host_permissions": ["https://fapi.example.com/*"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": {
      "id": "atlas-test@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
