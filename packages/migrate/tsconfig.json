{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Runs in a Node CLI (the exporters) and inside the Atlas API (the reader).
    // node:crypto and fetch are the only platform APIs it uses.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": []
}
