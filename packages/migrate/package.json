{
  "name": "@atlasauth/migrate",
  "version": "0.2.0",
  "description": "The vendor-neutral Atlas migration bundle: schema, sealing (X25519 + AES-256-GCM to your Atlas instance's import key), a validating writer and an upload client. Every `atlas migrate export <vendor>` exporter writes this format; Atlas imports it through /v1/migrations/{source}/imports.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "keywords": ["atlas", "atlasauth", "migration", "export", "auth"],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
