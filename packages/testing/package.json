{
  "name": "@atlasauth/testing",
  "version": "0.7.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "default": "./dist/e2e.js"
    },
    "./cypress": {
      "types": "./dist/cypress.d.ts",
      "default": "./dist/cypress.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40",
    "cypress": ">=12",
    "@atlasauth/backend": ">=0.49.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "cypress": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlasauth/backend": "workspace:*",
    "@playwright/test": "1.63.0",
    "cypress": "16.1.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/testing"
  }
}
