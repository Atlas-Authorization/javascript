{
  "name": "@atlasauth/graphql",
  "version": "0.3.0",
  "description": "GraphQL context helpers for Apollo Server and Express GraphQL.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "jose": "^5.9.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "@atlasauth/backend": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@atlasauth/backend": ">=0.51.0 <1.0.0"
  }
}
