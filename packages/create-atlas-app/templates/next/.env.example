# Atlas auth — copy this file to .env.local and fill in your instance's values.
#
# The publishable key (safe to expose to the browser). Get one at
# https://atlasauth.net. The scaffolder leaves a placeholder here.
NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY={{PUBLISHABLE_KEY}}

# The instance's Frontend API origin. On the hosted fleet this is the shared
# host until you verify a custom domain; then it's your domain (e.g.
# https://auth.example.com).
NEXT_PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# Edge JWT verification (used by middleware.ts and the server auth() helper).
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# Server-only secret key — NEVER prefix with NEXT_PUBLIC_. Only needed if you
# call the Backend API (atlasClient()) from server code.
# ATLAS_SECRET_KEY=sk_test_xxx
