# Atlas auth — copy this file to .env and fill in your instance's values.
#
# Where the middleware fetches the signing keys, and the issuer it expects.
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# Publishable key of the instance your clients sign in to (not read by this server): {{PUBLISHABLE_KEY}}

# Server-only secret key, needed only to call the Backend API. NEVER ship it to a client.
# ATLAS_SECRET_KEY=sk_test_xxx
