# Atlas auth — copy this file to .env and fill in your instance's values.
# Expo bundles EXPO_PUBLIC_ variables into the app, so only the publishable key goes here.
# NEVER put a secret key (sk_...) in a mobile app.
EXPO_PUBLIC_ATLAS_PUBLISHABLE_KEY={{PUBLISHABLE_KEY}}
EXPO_PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net
# Your own API, which verifies the session token with @atlasauth/backend.
EXPO_PUBLIC_API_URL=
