# Atlas auth — copy this file to .env and fill in your instance's values.
# Vite only exposes variables prefixed with VITE_ to the browser.
#
# The publishable key (safe to expose). Get one at https://atlasauth.net. The
# scaffolder leaves a placeholder here.
VITE_ATLAS_PUBLISHABLE_KEY={{PUBLISHABLE_KEY}}

# The instance's Frontend API origin. On the hosted fleet this is the shared
# host until you verify a custom domain; then it's your domain.
VITE_ATLAS_FRONTEND_API=https://atlasauth.net
