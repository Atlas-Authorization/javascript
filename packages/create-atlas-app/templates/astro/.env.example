# Atlas auth — copy this file to .env and fill in your instance's values.
#
# Where the middleware fetches the signing keys, and the issuer it expects (server only).
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# The page that signs people in (your Atlas hosted sign-in, or a page that mounts the
# @atlasauth/js client). Publishable key for that page: {{PUBLISHABLE_KEY}}
ATLAS_SIGN_IN_URL=
