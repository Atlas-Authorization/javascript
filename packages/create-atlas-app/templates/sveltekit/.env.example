# Atlas auth — copy this file to .env and fill in your instance's values.
#
# Public: SvelteKit only exposes variables prefixed with PUBLIC_ to the browser.
PUBLIC_ATLAS_PUBLISHABLE_KEY={{PUBLISHABLE_KEY}}
PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# Server only: where hooks.server.ts fetches the signing keys, and the issuer it expects.
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net
