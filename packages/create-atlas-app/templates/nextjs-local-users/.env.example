# Copy to .env.local. Every step of the order of operations is in README.md.

# Browser-safe. Your instance's publishable key.
NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY={{PUBLISHABLE_KEY}}

# Path mount: Atlas lives at <your host><ATLAS_BASE_PATH>, served by app/atlas/[[...path]]/route.ts.
ATLAS_BASE_PATH=/atlas
# The instance's Frontend API host (the "upstream" the claim answered with).
ATLAS_UPSTREAM=
# From POST /v1/instance/proxy_secret. Per instance: development and production differ.
ATLAS_PROXY_SECRET=
# From the domain claim; only needed until the mount is verified.
ATLAS_VERIFY_TOKEN=

# Verify session tokens locally. With a path mount the issuer is https://<your host><base path>.
ATLAS_JWKS_URL=https://localhost:3000/atlas/.well-known/jwks.json
ATLAS_ISSUER=https://localhost:3000/atlas

# Server-only. Never prefix with NEXT_PUBLIC_.
ATLAS_SECRET_KEY=
# Signs the CSRF token; falls back to a key derived from ATLAS_SECRET_KEY.
ATLAS_CSRF_SECRET=

# Signing secrets Atlas shows once when you create the webhook endpoint and the hook.
ATLAS_WEBHOOK_SECRET=
ATLAS_HOOK_SECRET=

# An Admin Portal profile (POST /v1/sso_onboarding_profiles) and an identity integration to mint a token for.
ATLAS_ADMIN_PORTAL_PROFILE_ID=
ATLAS_INTEGRATION=chatly
