{
  "name": "@atlasauth/nuxt",
  "version": "0.3.0",
  "type": "module",
  "description": "Official Nuxt 3 module for Atlas — SSR session verification (Nitro) built on the @atlasauth/vue client.",
  "license": "MIT",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "typecheck": "tsgo -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/vue": "workspace:*",
    "@atlasauth/backend": "workspace:*",
    "@atlasauth/authz": "workspace:*",
    "@nuxt/kit": "^3.13.0"
  },
  "peerDependencies": {
    "@atlasauth/js": ">=0.39.0 <1.0.0",
    "nuxt": "^3"
  },
  "devDependencies": {
    "@atlasauth/js": "workspace:*",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.13.0",
    "h3": "^1.12.0",
    "jose": "^5.9.6",
    "nuxt": "^3.13.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
