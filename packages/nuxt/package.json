{
  "name": "@atlasauth/nuxt",
  "version": "0.1.1",
  "type": "module",
  "description": "Official Nuxt 3 module for Atlas — SSR session verification (Nitro) built on the @atlasauth/vue client.",
  "license": "MIT",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/index.d.ts",
      "import": "./dist/runtime/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/vue": "workspace:*",
    "@atlasauth/js": "workspace:*",
    "@atlasauth/backend": "workspace:*",
    "@atlasauth/authz": "workspace:*",
    "@nuxt/kit": "^3.13.0"
  },
  "peerDependencies": {
    "nuxt": "^3"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.13.0",
    "h3": "^1.12.0",
    "jose": "^5.9.6",
    "nuxt": "^3.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/nuxt"
  }
}
