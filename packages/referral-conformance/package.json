{
  "name": "@atlasauth/referral-conformance",
  "version": "0.1.0",
  "description": "Conformance suite for the Atlas referral protocol (the Referalli connection API): recorded signed calls with the answers a server must give, a runner, and recorded inbound events. Run it against your own referral platform in CI.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "referral-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "keywords": ["atlas", "atlasauth", "referral", "referalli", "conformance", "webhook"],
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
