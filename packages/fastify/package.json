{
  "name": "@atlasauth/fastify",
  "version": "0.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/backend": "workspace:*"
  },
  "peerDependencies": {
    "fastify": ">=4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "jose": "^5.9.6",
    "fastify": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
