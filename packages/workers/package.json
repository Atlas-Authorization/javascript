{
  "name": "@atlasauth/workers",
  "version": "0.1.0",
  "description": "Atlas for Cloudflare Workers, Deno, Bun and any Web-standard Request/Response runtime: verify the session, require auth, rate limit, spend grant usage and receive webhooks, without a framework.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@atlasauth/backend": ">=0.51.0 <1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "jose": "^5.9.6",
    "@atlasauth/backend": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
