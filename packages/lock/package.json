{
  "name": "@atlasauth/lock",
  "version": "0.2.1",
  "description": "Drop-in, one-script embeddable login widget for Atlas — a batteries-included sign-in/up modal or inline panel you add with a single script tag. The Atlas peer of Auth0 Lock.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./atlas-lock.min.js": "./dist/atlas-lock.min.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/embed": "workspace:^",
    "@atlasauth/themes": "workspace:*"
  },
  "devDependencies": {
    "@atlasauth/js": "workspace:*",
    "@atlasauth/react": "workspace:*",
    "esbuild": "^0.25.12",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
