{
  "name": "@atlasauth/angular",
  "version": "0.23.2",
  "description": "Official Angular SDK for Atlas — the Angular peer of @atlasauth/react.",
  "license": "MIT",
  "module": "./dist/fesm2022/atlasauth-angular.mjs",
  "typings": "./dist/index.d.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "esm2022": "./dist/esm2022/atlasauth-angular.mjs",
      "default": "./dist/fesm2022/atlasauth-angular.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/design": "workspace:*",
    "@atlasauth/authz": "workspace:*",
    "tslib": "^2.6.3"
  },
  "peerDependencies": {
    "@atlasauth/js": ">=0.51.0 <1.0.0",
    "@angular/core": ">=20",
    "@angular/common": ">=20",
    "@angular/router": ">=20",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^20.3.28",
    "@angular/compiler": "^20.3.28",
    "@angular/compiler-cli": "^20.3.28",
    "@angular/core": "^20.3.28",
    "@angular/router": "^20.3.28",
    "@atlasauth/js": "workspace:*",
    "ng-packagr": "^20.3.2",
    "rxjs": "^7.8.1",
    "typescript": "~5.8.3",
    "zone.js": "~0.15.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/alphajew420/ssoly/tree/main/packages/angular#readme",
  "bugs": {
    "url": "https://github.com/alphajew420/ssoly/issues"
  }
}
