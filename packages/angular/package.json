{
  "name": "@atlasauth/angular",
  "version": "0.1.1",
  "description": "Official Angular SDK for Atlas — the Angular peer of @atlasauth/react.",
  "license": "MIT",
  "module": "./dist/fesm2022/atlas-angular.mjs",
  "typings": "./dist/index.d.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "esm2022": "./dist/esm2022/atlas-angular.mjs",
      "default": "./dist/fesm2022/atlas-angular.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atlasauth/js": "workspace:*",
    "@atlasauth/authz": "workspace:*",
    "tslib": "^2.6.3"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/common": ">=17",
    "@angular/router": ">=17",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/router": "^17.3.0",
    "ng-packagr": "^17.3.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.4.5",
    "zone.js": "^0.14.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/angular"
  }
}
