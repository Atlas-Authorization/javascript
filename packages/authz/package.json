{
  "name": "@atlasauth/authz",
  "version": "0.3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
