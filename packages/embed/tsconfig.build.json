{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Incremental: an unchanged package rebuilds in seconds. The build info
    // lives in dist, so deleting dist always forces a full rebuild.
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "declaration": true,
    "sourceMap": true
  },
  "exclude": ["src/**/*.test.ts"]
}
