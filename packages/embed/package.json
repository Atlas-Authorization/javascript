{
  "name": "@atlasauth/embed",
  "version": "0.20.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/design": "workspace:*",
    "@atlasauth/js": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.12",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/embed"
  }
}
