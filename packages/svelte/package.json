{
  "name": "@atlasauth/svelte",
  "version": "0.23.3",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/design": "workspace:*",
    "@atlasauth/authz": "workspace:*"
  },
  "peerDependencies": {
    "@atlasauth/js": ">=0.51.0 <1.0.0",
    "svelte": ">=4",
    "@sveltejs/kit": ">=1",
    "@atlasauth/backend": ">=0.62.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlasauth/backend": "workspace:*",
    "@atlasauth/js": "workspace:*",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@types/node": "^22.9.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.5",
    "typescript": "^5.6.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/alphajew420/ssoly/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/alphajew420/ssoly/issues"
  }
}
