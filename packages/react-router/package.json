{
  "name": "@atlasauth/react-router",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/react": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "jose": "^5.9.6",
    "@atlasauth/backend": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@atlasauth/backend": ">=0.67.0 <1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/react-router"
  }
}
