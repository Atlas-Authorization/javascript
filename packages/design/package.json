{
  "name": "@atlasauth/design",
  "version": "0.3.0",
  "description": "The Atlas design system: the structured design schema, presets, resolver, safe CSS compiler, contrast helpers and curated font list shared by Atlas hosted pages and SDK components.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "runtime": ["./dist/runtime.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "keywords": ["atlas", "atlasauth", "design-system", "theme", "appearance", "auth"],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "runtime",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphajew420/ssoly.git",
    "directory": "packages/design"
  },
  "homepage": "https://github.com/alphajew420/ssoly/tree/main/packages/design#readme",
  "bugs": {
    "url": "https://github.com/alphajew420/ssoly/issues"
  }
}
