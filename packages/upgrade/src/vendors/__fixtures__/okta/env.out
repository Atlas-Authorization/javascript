export const oktaConfig = {
  issuer: process.env.NEXT_PUBLIC_ATLAS_FRONTEND_API!,
  clientId: process.env.NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY!,
};

// TODO(atlas-migrate): OKTA_ORG_URL: the Okta org is not used after the move: server code reads ATLAS_ISSUER and ATLAS_SECRET_KEY
// TODO(atlas-migrate): OKTA_CLIENT_SECRET: server code uses ATLAS_SECRET_KEY (from the Atlas dashboard)
// TODO(atlas-migrate): OKTA_TESTING_DISABLEHTTPSCHECK: not needed with Atlas; remove it
export const serverConfig = {
  orgUrl: process.env.OKTA_ORG_URL!,
  clientSecret: process.env.OKTA_CLIENT_SECRET!,
  disableHttpsCheck: process.env.OKTA_TESTING_DISABLEHTTPSCHECK === 'true',
};
