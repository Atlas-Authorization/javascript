// TODO(atlas-migrate): KINDE_CLIENT_ID: server code identifies the instance with ATLAS_SECRET_KEY; the browser uses NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY
// TODO(atlas-migrate): KINDE_CLIENT_SECRET: server code uses ATLAS_SECRET_KEY (from the Atlas dashboard)
// TODO(atlas-migrate): KINDE_SITE_URL: not needed; add your app origin to the allowed origins in the Atlas dashboard
// TODO(atlas-migrate): KINDE_POST_LOGOUT_REDIRECT_URL: pass redirectUrl to <SignOutButton>
export const kindeConfig = {
  issuerUrl: process.env.ATLAS_ISSUER,
  clientId: process.env.KINDE_CLIENT_ID,
  clientSecret: process.env.KINDE_CLIENT_SECRET,
  siteUrl: process.env.KINDE_SITE_URL,
  postLogoutRedirectUrl: process.env.KINDE_POST_LOGOUT_REDIRECT_URL,
};
