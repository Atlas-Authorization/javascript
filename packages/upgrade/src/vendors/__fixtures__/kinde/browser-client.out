'use client';
import { useKindeBrowserClientCompat } from '@atlasauth/react/compat';

export function Profile() {
  const { user, isAuthenticated, isLoading, getPermission } = useKindeBrowserClientCompat();
  if (isLoading) return <p>Loading…</p>;
  if (!isAuthenticated) return <a href="/sign-in">Sign in</a>;
  const canEdit = getPermission('profile:edit').isGranted;
  return (
    <div>
      <img src={user?.picture ?? ''} alt="" />
      <p>
        {user?.given_name} {user?.family_name}
      </p>
      {canEdit && <a href="/profile/edit">Edit profile</a>}
    </div>
  );
}
