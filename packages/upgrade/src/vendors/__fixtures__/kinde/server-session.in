import { getKindeServerSession } from '@kinde-oss/kinde-auth-nextjs/server';
import { redirect } from 'next/navigation';

export default async function DashboardPage() {
  const { isAuthenticated, getUser, getPermission, getBooleanFlag } = getKindeServerSession();
  if (!(await isAuthenticated())) redirect('/api/auth/login?post_login_redirect_url=/dashboard');
  const user = await getUser();
  const billing = await getPermission('manage:billing');
  const beta = await getBooleanFlag('beta', false);
  return (
    <main>
      <h1>Welcome, {user?.given_name}</h1>
      {billing?.isGranted && <a href="/billing">Billing</a>}
      {beta && <p>Beta features are on</p>}
    </main>
  );
}
