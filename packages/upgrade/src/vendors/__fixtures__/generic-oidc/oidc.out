import { createHash, randomBytes } from 'node:crypto';

import { oidc } from '@atlasauth/backend';

const cache = new Map<string, any>();

export async function discover(issuer: string) {
  if (!cache.has(issuer)) {
    // TODO(atlas-migrate): OIDC discovery by hand: discovery (and its cache) is built into oidc.start / oidc.callback / oidc.logoutUrl
    const res = await fetch(`${issuer}/.well-known/openid-configuration`);
    cache.set(issuer, await res.json());
  }
  return cache.get(issuer);
}

export async function newPendingSignIn(issuer: string, clientId: string, redirectUri: string) {
  const cfg = await discover(issuer);
  const codeVerifier = randomBytes(32).toString('base64url');
  const challenge = createHash('sha256').update(codeVerifier).digest('base64url');
  const url = new URL(cfg.authorization_endpoint);
  url.searchParams.set('client_id', clientId);
  // TODO(atlas-migrate): PKCE by hand: state, nonce and the PKCE verifier/challenge are generated by oidc.start and read back by oidc.callback
  url.searchParams.set('code_challenge', challenge);
  url.searchParams.set('code_challenge_method', 'S256');
  url.searchParams.set('redirect_uri', redirectUri);
  return { url: url.toString(), codeVerifier };
}

export async function completeSignIn(cfg: any, code: string, codeVerifier: string) {
  // TODO(atlas-migrate): code exchange by hand: oidc.callback({ issuer, clientId, clientSecret, redirectUri, query, cookie, secret }) checks state, exchanges the code with PKCE, verifies the ID token (alg pinned, iss, aud, azp, nonce, at_hash) and returns { sub, namespacedSub, email, emailVerified, claims, idToken, accessToken, refreshToken }
  const body = new URLSearchParams({ grant_type: 'authorization_code', code, code_verifier: codeVerifier });
  return (await fetch(cfg.token_endpoint, { method: 'POST', body })).json();
}

// TODO(atlas-migrate): logout URL by hand: oidc.logoutUrl({ issuer, clientId, postLogoutRedirectUri, idTokenHint }) builds the end_session URL from discovery
export const logoutUrl = (cfg: any) => cfg.end_session_endpoint;
