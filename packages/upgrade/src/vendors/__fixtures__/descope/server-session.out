import { redirect } from 'next/navigation';
import { descopeSessionCompat } from '@atlasauth/nextjs/compat';

export default async function Dashboard() {
  const currentSession = await descopeSessionCompat();
  if (!currentSession) redirect('/sign-in');
  const roles = currentSession.token.roles as string[];
  return <h1>Hello {currentSession.token.sub} ({roles.join(', ')})</h1>;
}
