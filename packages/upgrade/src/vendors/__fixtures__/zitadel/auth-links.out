'use client';
import type { ReactNode } from 'react';

export function Nav({ signedIn, children }: { signedIn: boolean; children: ReactNode }) {
  if (!children) return null;
  // TODO(atlas-migrate): /oidc/v1/end_session: sign-out is an action in Atlas; use <SignOutButton /> or useAuth().signOut() from @atlasauth/react
  return signedIn ? <a href="/oidc/v1/end_session">Sign out</a> : <a href="/sign-up">Create account</a>;
}
