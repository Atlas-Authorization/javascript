import { type NextRequest } from 'next/server';
import { createAtlasMiddleware } from '@atlasauth/nextjs/compat';
const atlasMiddleware = createAtlasMiddleware();

export async function middleware(request: NextRequest) {
  return await atlasMiddleware(request);
}

export const config = {
  matcher: ['/((?!_next/static|_next/image|favicon.ico).*)'],
};
