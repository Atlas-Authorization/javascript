// TODO(atlas-migrate): 'Issuer' from 'openid-client': Issuer.discover(...) / new Issuer(...): discovery (and its cache) is built into oidc.start / oidc.callback / oidc.logoutUrl
// TODO(atlas-migrate): 'generators' from 'openid-client': state, nonce and the PKCE verifier/challenge are generated by oidc.start and read back by oidc.callback
import { Issuer, generators } from 'openid-client';

import { oidc } from '@atlasauth/backend';

// TODO(atlas-migrate): discover(): discovery (and its cache) is built into oidc.start / oidc.callback / oidc.logoutUrl
const issuer = await Issuer.discover(process.env.OIDC_ISSUER!);
const client = new issuer.Client({
  client_id: process.env.OIDC_CLIENT_ID!,
  client_secret: process.env.OIDC_CLIENT_SECRET!,
  redirect_uris: ['https://app.example.com/callback'],
  response_types: ['code'],
});

export function start(req, res) {
  // TODO(atlas-migrate): generators.state(): state, nonce and the PKCE verifier/challenge are generated by oidc.start and read back by oidc.callback
  const state = generators.state();
  // TODO(atlas-migrate): generators.nonce(): state, nonce and the PKCE verifier/challenge are generated by oidc.start and read back by oidc.callback
  const nonce = generators.nonce();
  // TODO(atlas-migrate): generators.codeVerifier(): state, nonce and the PKCE verifier/challenge are generated by oidc.start and read back by oidc.callback
  const codeVerifier = generators.codeVerifier();
  // TODO(atlas-migrate): authorizationUrl(): oidc.start({ issuer, clientId, redirectUri, secret }) returns { url, cookie }: redirect to url and send cookie as Set-Cookie (state, nonce and PKCE are generated and kept in a sealed cookie)
  // TODO(atlas-migrate): generators.codeChallenge(): state, nonce and the PKCE verifier/challenge are generated by oidc.start and read back by oidc.callback
  const url = client.authorizationUrl({
    scope: 'openid email profile',
    state,
    nonce,
    code_challenge: generators.codeChallenge(codeVerifier),
    code_challenge_method: 'S256',
  });
  res.redirect(url);
}

export async function finish(req, res) {
  // TODO(atlas-migrate): callbackParams(): the callback query goes to oidc.callback as `query` (a URLSearchParams, URL string or parsed object)
  const params = client.callbackParams(req);
  // TODO(atlas-migrate): callback(): oidc.callback({ issuer, clientId, clientSecret, redirectUri, query, cookie, secret }) checks state, exchanges the code with PKCE, verifies the ID token (alg pinned, iss, aud, azp, nonce, at_hash) and returns { sub, namespacedSub, email, emailVerified, claims, idToken, accessToken, refreshToken }
  const tokenSet = await client.callback('https://app.example.com/callback', params, { state: req.session.state, nonce: req.session.nonce });
  req.session.user = tokenSet.claims().sub;
  // TODO(atlas-migrate): endSessionUrl(): oidc.logoutUrl({ issuer, clientId, postLogoutRedirectUri, idTokenHint }) builds the end_session URL from discovery
  res.redirect(client.endSessionUrl({ id_token_hint: tokenSet.id_token }));
}
