// TODO(atlas-migrate): NEXT_PUBLIC_AUTH_URL: remove once the zero-logout bridge is retired (the bridge needs it until then); the browser uses NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY
// TODO(atlas-migrate): PROPELAUTH_API_KEY: replace with ATLAS_SECRET_KEY (keep the PropelAuth key until your export is done)
// TODO(atlas-migrate): PROPELAUTH_VERIFIER_KEY: remove once the zero-logout bridge is retired (the propelauth bridge preset needs it until then)
// TODO(atlas-migrate): PROPELAUTH_REDIRECT_URI: remove (not needed with Atlas)
export const propelauthConfig = {
  authUrl: process.env.NEXT_PUBLIC_AUTH_URL,
  apiKey: process.env.PROPELAUTH_API_KEY,
  verifierKey: process.env.PROPELAUTH_VERIFIER_KEY,
  redirectUri: process.env.PROPELAUTH_REDIRECT_URI,
};
