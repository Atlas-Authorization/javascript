import { createAuth0Client, type User } from '@auth0/auth0-spa-js';

export const auth0Ready = createAuth0Client({
  domain: import.meta.env.VITE_AUTH0_DOMAIN,
  clientId: import.meta.env.VITE_AUTH0_CLIENT_ID,
  authorizationParams: { redirect_uri: window.location.origin },
});

export async function boot(): Promise<User | undefined> {
  const auth0 = await auth0Ready;
  if (location.search.includes('code=') && location.search.includes('state=')) {
    const { appState } = await auth0.handleRedirectCallback();
    history.replaceState({}, '', (appState as { target?: string })?.target ?? '/');
  }
  await auth0.checkSession();
  if (!(await auth0.isAuthenticated())) {
    await auth0.loginWithRedirect({ appState: { target: location.pathname } });
    return undefined;
  }
  return auth0.getUser();
}

export async function callApi(path: string) {
  const auth0 = await auth0Ready;
  const token = await auth0.getTokenSilently();
  return fetch(path, { headers: { authorization: `Bearer ${token}` } });
}

export async function signInWithGitHub() {
  const auth0 = await auth0Ready;
  await auth0.loginWithPopup({ authorizationParams: { connection: 'github' } });
  return auth0.getTokenWithPopup();
}

export async function signOut() {
  const auth0 = await auth0Ready;
  await auth0.logout({ logoutParams: { returnTo: window.location.origin } });
}
