// TODO(atlas-migrate): 'CognitoJwtVerifier' from 'aws-jwt-verify': CognitoJwtVerifier: verify Atlas session tokens with new AtlasBackend({ ... }).verify(token) from @atlasauth/backend; keep accepting Cognito tokens during the cutover with legacyIssuers
import { CognitoJwtVerifier } from 'aws-jwt-verify';

const verifier = CognitoJwtVerifier.create({ userPoolId: 'us-east-1_abc', tokenUse: 'id', clientId: 'client' });

export async function verify(token: string) {
  return verifier.verify(token);
}
