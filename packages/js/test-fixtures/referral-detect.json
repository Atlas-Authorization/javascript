{
  "_comment": "Shared by the JS SDK detector (packages/js/src/referral-detect.ts) and the ES5 copy in the Atlas API (hosted pages, Sign in with Atlas button). `fns` turns a dotted path into a function on the window: most return the value; cmplz_has_consent looks the category up in the value; __tcfapi calls back with it. `cookies` is document.cookie.",
  "sources": [
    {
      "name": "Referalli aff.js",
      "win": {},
      "fns": {
        "aff.getReferral": {
          "code": "WJXQGLBW",
          "clickId": "clk_123",
          "anonId": "a_456",
          "ts": 1792600000
        }
      },
      "sources": [
        "referalli"
      ],
      "expect": {
        "source": "referalli",
        "code": "WJXQGLBW",
        "clickId": "clk_123",
        "anonId": "a_456",
        "capturedAt": "2026-10-21T16:26:40.000Z"
      }
    },
    {
      "name": "Rewardful referral and affiliate token",
      "win": {
        "Rewardful": {
          "referral": "8a4f0e9c-1b2d-4c3e-9f00-1234567890ab",
          "affiliate": {
            "token": "dana"
          }
        }
      },
      "sources": [
        "rewardful"
      ],
      "expect": {
        "source": "rewardful",
        "code": "dana",
        "clickId": "8a4f0e9c-1b2d-4c3e-9f00-1234567890ab",
        "anonId": null
      }
    },
    {
      "name": "Rewardful loaded without a referral",
      "win": {
        "Rewardful": {
          "referral": "",
          "affiliate": false
        }
      },
      "sources": [
        "rewardful"
      ],
      "expect": null
    },
