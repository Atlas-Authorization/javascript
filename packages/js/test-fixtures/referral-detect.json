        "tolt"
      ],
      "expect": {
        "source": "tolt",
        "code": null,
        "clickId": "tlt_1x",
        "anonId": null
      }
    },
    {
      "name": "A throwing script reads as nothing",
      "win": {},
      "fns": {
        "aff.getReferral": "__throw__"
      },
      "sources": [
        "referalli"
      ],
      "expect": null
    }
  ],
