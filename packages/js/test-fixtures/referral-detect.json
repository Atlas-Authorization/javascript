    {
      "name": "A source not listed for the instance is never read",
      "win": {
        "Rewardful": {
          "referral": "rw_ref_1"
        }
      },
      "fns": {
        "aff.getReferral": {
          "code": "WJXQGLBW"
        }
      },
      "sources": [
        "referalli"
      ],
      "expect": {
        "source": "referalli",
        "code": "WJXQGLBW",
        "clickId": null,
        "anonId": null
      }
    },
    {
      "name": "Order follows the list",
      "win": {
        "tolt_referral": "tlt_first",
        "Rewardful": {
          "referral": "rw_second"
        }
      },
      "sources": [
        "tolt",
        "rewardful"
      ],
      "expect": {
        "source": "tolt",
        "code": null,
        "clickId": "tlt_first",
        "anonId": null
      }
    },
    {
      "name": "Malformed values are dropped",
      "win": {
        "tolt_referral": "has spaces!"
      },
      "sources": [
        "tolt"
      ],
      "expect": null
    },
    {
      "name": "Unknown source ids are skipped",
      "win": {
        "tolt_referral": "tlt_1x"
      },
      "sources": [
