{
  "name": "@atlasauth/better-auth-migrate",
  "version": "0.3.0",
  "description": "Export a Better Auth app (users, passwords, social accounts, two-factor, passkeys, API keys, organizations, SSO, OAuth apps, subscriptions, sessions) into an encrypted bundle for import into Atlas. Runs inside your app, through your own Better Auth database adapter.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": ["./dist/testing/index.d.ts"]
    }
  },
  "bin": {
    "atlas-better-auth-export": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "keywords": ["atlas", "atlasauth", "better-auth", "migration", "export", "auth"],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@noble/ciphers": "1.3.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
