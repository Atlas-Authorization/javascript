{
  "name": "@atlasauth/cli",
  "version": "0.15.0",
  "description": "atlas \u2014 manage an Atlas instance from the terminal via the Backend API.",
  "bin": {
    "atlas": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --no-isolate"
  },
  "dependencies": {
    "@atlasauth/actions": "workspace:*",
    "@atlasauth/backend": "workspace:*",
    "@atlasauth/emulator": "workspace:*",
    "@atlasauth/migrate": "workspace:*",
    "@atlasauth/referral-conformance": "workspace:*",
    "@atlasauth/upgrade": "workspace:*",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "github-action",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
