        "token_endpoint_auth_method": "client_secret_basic",
        "userinfo_endpoint": "https://crm.kitchen.example/api/me",
      },
    ],
    "instance": {
      "allowed_origins": [
        "https://kitchen.example",
        "https://admin.kitchen.example",
      ],
      "auth_config": {
        "accountLinking": "block",
        "accountUx": {
          "lastSignInMethod": {
            "enabled": true,
          },
          "username": {
            "maxLength": 20,
            "minLength": 4,
          },
        },
        "identityTraits": {
          "traits": [
            {
              "key": "plan",
              "type": "string",
              "userEditable": false,
            },
            {
              "key": "age",
              "type": "number",
              "userEditable": true,
            },
            {
