{
  "document": {
    "billing_plans": [],
    "custom_oauth_providers": [],
    "instance": {
      "allowed_origins": [
        "\${BETTER_AUTH_URL}",
      ],
      "auth_config": {
        "accountLinking": "auto",
        "accountLinkingTrust": {
          "discord": "always",
        },
        "captcha": {
          "flows": {
            "passwordReset": {
              "enabled": true,
            },
            "signIn": {
              "enabled": true,
            },
            "signUp": {
              "enabled": true,
            },
          },
          "provider": "turnstile",
          "siteKey": "\${CAPTCHA_SITE_KEY}",
        },
        "endUserApiKeys": {
          "defaultExpiresInSeconds": 2592000,
          "keyPrefix": "split",
          "maxExpiresInSeconds": 7776000,
          "selfServiceEnabled": true,
        },
        "identityTraits": {
          "traits": [
            {
              "enum": [
                "user",
                "admin",
                "support",
              ],
              "key": "role",
              "type": "enum",
              "userEditable": false,
            },
          ],
        },
        "mfa": {
          "backupCodes": {
            "count": 8,
          },
          "factors": {
            "passkey": true,
            "totp": true,
          },
          "rememberDevice": {
            "days": 14,
            "enabled": true,
          },
          "totp": {
            "digits": 6,
            "period": 30,
          },
        },
        "mfaPolicy": "optional",
        "organizations": {
          "allowCustomRolesFromApp": false,
          "creatorRole": "org:admin",
          "defaultMaxAllowedMemberships": 50,
          "invitationTtlSeconds": 604800,
          "maxMembersPerTeam": 25,
          "maxOrganizationsPerUser": 5,
          "maxPendingInvitationsPerOrganization": 100,
          "maxTeamsPerOrganization": 10,
        },
        "passkeyPolicy": {
          "requireUserVerification": true,
        },
        "requireEmailVerification": false,
        "session": {
          "absoluteMs": 604800000,
          "crossSubdomainCookies": false,
          "idleMs": 604800000,
          "idleTimeout": false,
          "multiSession": false,
        },
        "signInAfterReset": false,
        "stepUp": {
          "enabled": true,
          "windowMs": 600000,
        },
        "strategies": {
          "anonymous": false,
          "emailCode": true,
          "emailLink": true,
          "oauthProviders": [
            "discord",
          ],
          "passkey": true,
          "password": true,
          "phoneCode": false,
          "siwe": false,
          "username": false,
        },
        "verification": {
          "emailCode": {
            "length": 8,
            "maxAttempts": 5,
            "ttlMinutes": 5,
          },
          "magicLink": {
            "ttlMinutes": 10,
          },
        },
      },
    },
    "jwt_templates": [],
    "oauth_clients": [],
    "oauth_providers": [
      {
        "allow_sign_in": true,
        "allow_sign_up": false,
        "client_id": "\${DISCORD_CLIENT_ID}",
        "client_secret": "\${DISCORD_CLIENT_SECRET}",
        "enabled": true,
        "provider": "discord",
      },
    ],
    "permissions": [
      {
        "description": "billing: manage",
        "key": "org:billing:manage",
        "name": "billing manage",
      },
      {
        "description": "project: create",
        "key": "org:project:create",
        "name": "project create",
      },
      {
        "description": "project: update",
        "key": "org:project:update",
        "name": "project update",
      },
    ],
    "redirect_urls": [],
    "resource_servers": [],
    "roles": [
      {
        "description": "Migrated from the Better Auth "admin" role.",
        "key": "org:admin_ba",
        "name": "Admin",
        "permissions": [
          "org:project:create",
          "org:project:update",
          "org:sys_memberships:manage",
          "org:sys_memberships:read",
          "org:sys_profile:manage",
        ],
      },
      {
        "description": "Migrated from the Better Auth "billingManager" role.",
        "key": "org:billingmanager",
        "name": "BillingManager",
        "permissions": [
          "org:billing:manage",
          "org:sys_memberships:manage",
        ],
      },
    ],
  },
  "env": [
    {
      "for": "your app origin (allowed origins)",
      "name": "BETTER_AUTH_URL",
    },
    {
      "for": "captcha site key (the public key your sign-in form used)",
      "name": "CAPTCHA_SITE_KEY",
    },
    {
      "for": "discord client id",
      "name": "DISCORD_CLIENT_ID",
    },
    {
      "for": "discord client secret",
      "name": "DISCORD_CLIENT_SECRET",
    },
  ],
  "mappings": {
    "providers": {
      "discord": "discord",
    },
    "roles": {
      "admin": "org:admin_ba",
      "billingManager": "org:billingmanager",
      "member": "org:member",
      "owner": "org:admin",
    },
  },
