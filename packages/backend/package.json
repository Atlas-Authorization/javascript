{
  "name": "@atlasauth/backend",
  "version": "0.64.1",
  "main": "./dist/index.js",
  "bin": {
    "atlas-doctor": "./dist/doctor-cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rp": {
      "types": "./dist/rp.d.ts",
      "default": "./dist/rp.js"
    },
    "./pca": {
      "types": "./dist/pca-entry.d.ts",
      "default": "./dist/pca-entry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./cli": {
      "types": "./dist/cli-login.d.ts",
      "default": "./dist/cli-login.js"
    },
    "./machine": {
      "types": "./dist/machine-client.d.ts",
      "default": "./dist/machine-client.js"
    },
    "./pinned-fetch": {
      "types": "./dist/web-bot-auth-pinned.d.ts",
      "default": "./dist/web-bot-auth-pinned.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "default": "./dist/rate-limit.js"
    },
    "./usage-gate": {
      "types": "./dist/usage-gate.d.ts",
      "default": "./dist/usage-gate.js"
    },
    "./entitlements": {
      "types": "./dist/entitlements.d.ts",
      "default": "./dist/entitlements.js"
    },
    "./approval-gate": {
      "types": "./dist/approval-gate.d.ts",
      "default": "./dist/approval-gate.js"
    },
    "./mirror": {
      "types": "./dist/mirror/index.d.ts",
      "default": "./dist/mirror/index.js"
    },
    "./mirror/drizzle": {
      "types": "./dist/mirror/drizzle.d.ts",
      "default": "./dist/mirror/drizzle.js"
    },
    "./mirror/prisma": {
      "types": "./dist/mirror/prisma.d.ts",
      "default": "./dist/mirror/prisma.js"
    },
    "./link": {
      "types": "./dist/link/index.d.ts",
      "default": "./dist/link/index.js"
    },
    "./link/testing": {
      "types": "./dist/link/testing.d.ts",
      "default": "./dist/link/testing.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "rp": [
        "./dist/rp.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ],
      "cli": [
        "./dist/cli-login.d.ts"
      ],
      "machine": [
        "./dist/machine-client.d.ts"
      ],
      "pinned-fetch": [
        "./dist/web-bot-auth-pinned.d.ts"
      ],
      "rate-limit": [
        "./dist/rate-limit.d.ts"
      ],
      "usage-gate": [
        "./dist/usage-gate.d.ts"
      ],
      "entitlements": [
        "./dist/entitlements.d.ts"
      ],
      "approval-gate": [
        "./dist/approval-gate.d.ts"
      ],
      "mirror": [
        "./dist/mirror/index.d.ts"
      ],
      "mirror/drizzle": [
        "./dist/mirror/drizzle.d.ts"
      ],
      "mirror/prisma": [
        "./dist/mirror/prisma.d.ts"
      ],
      "link": [
        "./dist/link/index.d.ts"
      ],
      "link/testing": [
        "./dist/link/testing.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-optional-requires.mjs",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --no-isolate"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@noble/curves": "^1.9.1",
    "@atlasauth/authz": "workspace:*"
  },
  "devDependencies": {
    "@atlasauth/pca": "workspace:^",
    "@opentelemetry/api": "1.10.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/alphajew420/ssoly/tree/main/packages/backend#readme",
  "bugs": {
    "url": "https://github.com/alphajew420/ssoly/issues"
  },
  "peerDependencies": {
    "@atlasauth/pca": "^0.5.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@atlasauth/pca": {
      "optional": true
    }
  }
}
