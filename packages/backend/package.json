{
  "name": "@atlasauth/backend",
  "version": "0.46.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rp": {
      "types": "./dist/rp.d.ts",
      "default": "./dist/rp.js"
    },
    "./pca": {
      "types": "./dist/pca-entry.d.ts",
      "default": "./dist/pca-entry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./cli": {
      "types": "./dist/cli-login.d.ts",
      "default": "./dist/cli-login.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "rp": [
        "./dist/rp.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ],
      "cli": [
        "./dist/cli-login.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --no-isolate"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@noble/curves": "^1.9.1",
    "@atlasauth/authz": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "@atlasauth/pca": "^0.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphajew420/ssoly.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/alphajew420/ssoly/tree/main/packages/backend#readme",
  "bugs": {
    "url": "https://github.com/alphajew420/ssoly/issues"
  },
  "peerDependencies": {
    "@atlasauth/pca": "^0.4.3"
  },
  "peerDependenciesMeta": {
    "@atlasauth/pca": {
      "optional": true
    }
  }
}
