{
  "name": "@atlasauth/passport",
  "version": "0.1.1",
  "description": "Passport.js strategies for Atlas — an OIDC authorization-code strategy for interactive login and a bearer/JWT strategy for API routes, both wrapping @atlasauth/backend.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/backend": "workspace:*",
    "jose": "^5.9.6",
    "passport-strategy": "^1.0.0"
  },
  "devDependencies": {
    "@types/passport-strategy": "^0.2.38",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "peerDependencies": {
    "passport": "^0.6.0 || ^0.7.0"
  },
  "peerDependenciesMeta": {
    "passport": {
      "optional": true
    }
  },
  "keywords": [
    "atlas",
    "atlasauth",
    "passport",
    "passport-strategy",
    "oidc",
    "oauth2",
    "pkce",
    "jwt",
    "authentication"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphajew420/ssoly.git",
    "directory": "packages/passport-atlas"
  },
  "homepage": "https://github.com/alphajew420/ssoly/tree/main/packages/passport-atlas#readme",
  "bugs": {
    "url": "https://github.com/alphajew420/ssoly/issues"
  }
}
