{
  "name": "@atlasauth/expo",
  "version": "0.11.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./account-security": {
      "types": "./dist/account-security.d.ts",
      "default": "./dist/account-security.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "account-security": [
        "./dist/account-security.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlasauth/react": "workspace:^",
    "@atlasauth/react-native": "workspace:^"
  },
  "peerDependencies": {
    "@atlasauth/js": ">=0.44.0 <1.0.0",
    "react": ">=18",
    "react-native": ">=0.73",
    "expo-secure-store": ">=12",
    "expo-web-browser": ">=12",
    "expo-auth-session": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "expo-auth-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlasauth/js": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ]
}
