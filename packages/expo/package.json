{
  "name": "@atlasauth/expo",
  "version": "0.16.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./account-security": {
      "types": "./dist/account-security.d.ts",
      "default": "./dist/account-security.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "account-security": [
        "./dist/account-security.d.ts"
      ],
      "session": [
        "./dist/session.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit --module preserve --moduleResolution bundler --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@atlasauth/js": ">=0.58.2 <1.0.0",
    "@atlasauth/react": ">=0.41.0 <1.0.0",
    "@atlasauth/react-native": ">=0.11.0 <1.0.0",
    "react": ">=18",
    "react-native": ">=0.73",
    "expo-secure-store": ">=12",
    "expo-web-browser": ">=12",
    "expo-auth-session": ">=5",
    "expo-constants": ">=15",
    "expo-linking": ">=6",
    "expo-crypto": ">=12"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-web-browser": {
      "optional": true
    },
    "expo-auth-session": {
      "optional": true
    },
    "expo-constants": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlasauth/js": "workspace:*",
    "@atlasauth/react": "workspace:*",
    "@atlasauth/react-native": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "expo-auth-session": "57.0.13",
    "expo-secure-store": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "^18.3.1",
    "react-native": "0.86.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlas-Authorization/javascript.git",
    "directory": "packages/expo"
  }
}
